<?xml version='1.0' encoding='utf-8'?>
<robot name="open-elbow-exoskeleton">
  <link name="world" />
  <link name="upper_arm">
    <inertial>
      <origin xyz="-0.13 0 0" rpy="0 0 0" />
      <mass value="0.65" />
      <inertia ixx="0.0003" ixy="0" ixz="0" iyy="0.0036616666666666672" iyz="0" izz="0.0036616666666666672" />
    </inertial>
    <visual>
      <origin xyz="-0.13 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.26 0.035 0.012" />
      </geometry>
      <material name="upper_arm_color">
        <color rgba="0.18 0.24 0.34 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="-0.13 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.26 0.035 0.012" />
      </geometry>
    </collision>
  </link>
  <link name="forearm">
    <inertial>
      <origin xyz="0.12 0 0" rpy="0 0 0" />
      <mass value="0.5" />
      <inertia ixx="0.0003" ixy="0" ixz="0" iyy="0.0378" iyz="0" izz="0.0378" />
    </inertial>
    <visual>
      <origin xyz="0.12 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.24 0.035 0.012" />
      </geometry>
      <material name="forearm_color">
        <color rgba="0.05 0.55 0.65 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0.12 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.24 0.035 0.012" />
      </geometry>
    </collision>
  </link>
  <joint name="bench_mount" type="fixed">
    <parent link="world" />
    <child link="upper_arm" />
  </joint>
  <joint name="elbow_flexion" type="revolute">
    <parent link="upper_arm" />
    <child link="forearm" />
    <origin xyz="0 0 0" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="0.17453292519943295" upper="2.0943951023931953" effort="1.0" velocity="1.0" />
    <dynamics damping="0.15" friction="0" />
  </joint>
  <transmission name="gearbox_and_belt">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="elbow_flexion">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
    </joint>
    <actuator name="brushed_motor">
      <mechanicalReduction>90.0</mechanicalReduction>
    </actuator>
  </transmission>
</robot>